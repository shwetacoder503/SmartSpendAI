<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#20304A" />
            <corners android:radius="13dp" />
            <stroke android:width="1.5dp" android:color="@color/gold" />
            <padding android:left="15dp" android:top="14dp" android:right="15dp" android:bottom="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#1FF2F0EA" />
            <padding android:left="15dp" android:top="14dp" android:right="15dp" android:bottom="14dp" />
        </shape>
    </item>
</selector>
