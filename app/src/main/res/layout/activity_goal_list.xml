<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:layout_marginBottom="16dp">

            <TextView
                style="@style/TextHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="20sp"
                android:text="Saving Goals" />

            <TextView
                android:id="@+id/tvWhatIfIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔮"
                android:textSize="18sp"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:gravity="center"
            android:text="No goals yet.\nTap + to create your first saving goal."
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerGoals"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:paddingBottom="90dp"
            android:clipToPadding="false" />
    </LinearLayout>

    <Button
        android:id="@+id/fabAddGoal"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="@drawable/bg_button_primary"
        android:text="+"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/on_gold"
        android:elevation="8dp" />

</FrameLayout>
